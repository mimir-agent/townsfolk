{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mimir-agent/townsfolk/protocol/day-end-response.schema.json",
  "title": "POST /v1/day-end response (200)",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "ok", "pending"],
  "properties": {
    "v": { "$ref": "common.schema.json#/$defs/v" },
    "ok": { "const": true },
    "pending": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/name" }, "description": "NPCs whose memory gets this day once it is saved." }
  }
}
