{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mimir-agent/townsfolk/protocol/day-end-request.schema.json",
  "title": "POST /v1/day-end request",
  "description": "Sent at DayEnding, every day, even with no events. The brain holds it as the pending day; nothing reaches memory until POST /v1/saved for the same date. A newer day-end replaces an uncommitted pending day.",
  "type": "object",
  "required": ["v", "saveId", "playerName", "day", "events"],
  "properties": {
    "v": { "$ref": "common.schema.json#/$defs/v" },
    "saveId": { "$ref": "common.schema.json#/$defs/name" },
    "playerName": { "type": "string", "minLength": 1, "maxLength": 40 },
    "day": { "$ref": "common.schema.json#/$defs/gameDay" },
    "events": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/event" } },
    "together": {
      "type": "array",
      "maxItems": 200,
      "description": "Groups of NPCs the bridge saw on the same map at the same time today, with or without the player. Gossip passes between them overnight. Optional.",
      "items": {
        "type": "object",
        "required": ["location", "npcs"],
        "properties": {
          "location": { "type": "string", "minLength": 1, "maxLength": 80 },
          "npcs": { "type": "array", "minItems": 2, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/name" } }
        }
      }
    }
  },
  "$defs": {
    "witnesses": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" },
      "description": "Other NPCs in the same location when it happened. Never includes npc itself."
    },
    "event": {
      "type": "object",
      "required": ["type", "npc", "location", "time", "witnesses"],
      "properties": {
        "type": { "enum": ["talk", "gift", "join"] },
        "npc": { "$ref": "common.schema.json#/$defs/name", "description": "The NPC who took part." },
        "location": { "type": "string", "minLength": 1, "maxLength": 80 },
        "time": { "type": "integer", "minimum": 600, "maximum": 2600 },
        "witnesses": { "$ref": "#/$defs/witnesses" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "talk" },
            "npcLine": { "type": "string", "minLength": 1, "maxLength": 400 },
            "playerChoice": { "type": "string", "minLength": 1, "maxLength": 200 },
            "fact": { "$ref": "common.schema.json#/$defs/talkFact", "description": "The fact on the picked choice, if it had one." }
          },
          "required": ["npcLine"]
        },
        {
          "description": "The player picked a join choice. npc is who they were talking to; witnesses are the other participants from the talk response's happening, and nobody else.",
          "properties": {
            "type": { "const": "join" },
            "topic": { "type": "string", "minLength": 1, "maxLength": 120 }
          },
          "required": ["topic"]
        },
        {
          "properties": {
            "type": { "const": "gift" },
            "item": { "type": "string", "minLength": 1, "maxLength": 80 },
            "taste": { "type": "string", "minLength": 1, "maxLength": 20 }
          },
          "required": ["item"]
        }
      ]
    }
  }
}
